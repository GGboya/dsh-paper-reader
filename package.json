{
  "name": "@ggboy123/dsh-paper-reader",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：论文伴读工作台 — PDF 转录 / 检索 / 原生对话伴读 + 内置阅读器页面。",
  "license": "MIT",
  "type": "module",
  "author": "GGboya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGboya/dsh-paper-reader.git"
  },
  "bugs": {
    "url": "https://github.com/GGboya/dsh-paper-reader/issues"
  },
  "homepage": "https://github.com/GGboya/dsh-paper-reader#readme",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "reader",
    "presets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "pdf",
    "pdf-reader",
    "paper",
    "paper-reading",
    "research-paper",
    "citation",
    "reader",
    "arxiv",
    "ai-assistant",
    "rag",
    "translation"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "pdfjs-dist": "^6.3.289"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
